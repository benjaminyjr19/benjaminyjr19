# ── Supabase ──────────────────────────────────────────────────────────────
# Leave these unset to run Atlas in preview mode (in-memory demo data, no auth).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used for privileged operations (storage, admin tasks). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── Atlas intelligence ────────────────────────────────────────────────────
# One of: anthropic | openai | mock
# Leave unset to auto-detect: anthropic key → anthropic, openai key → openai, otherwise mock.
AI_PROVIDER=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
