# Source data and derived outputs are never committed. The raw files are not
# redistributable and every derived file can be regenerated by the pipeline.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Jupyter
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/
.pytest_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
ENV/
env/

# Editors and operating systems
.vscode/
.idea/
.DS_Store
.DS_Store?
._*
Thumbs.db
